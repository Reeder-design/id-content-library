{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reeder-design.github.io/id-content-library/library-data/item-schema.json",
  "title": "Learning Content Lab Item",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "slug",
    "summary",
    "content_type",
    "format",
    "tools",
    "tags",
    "library_status",
    "preview_type",
    "created"
  ],
  "properties": {
    "title": {"type": "string", "minLength": 1},
    "slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "summary": {"type": "string", "minLength": 1},
    "content_type": {
      "type": "string",
      "enum": [
        "Interactive Learning",
        "Templates & Frameworks",
        "Assessment & Practice",
        "Sales Enablement",
        "Job Aids & Resources",
        "Multimedia",
        "Prompt Library",
        "Code & Automation",
        "Design Patterns",
        "Other"
      ]
    },
    "format": {"type": "string", "minLength": 1},
    "tools": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "library_status": {
      "type": "string",
      "enum": ["experimental", "stable", "archived", "other"]
    },
    "preview_type": {
      "type": "string",
      "enum": ["interactive", "document", "image", "video", "code", "text", "download", "none", "other"]
    },
    "created": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "updated": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "portfolio_status": {
      "type": "string",
      "enum": ["library-only", "portfolio-candidate", "featured-in-portfolio", "other"]
    },
    "thumbnail": {"type": "string", "minLength": 1},
    "thumbnail_mode": {"type": "string", "enum": ["frame", "upload", "icon"]},
    "thumbnail_icon": {"type": "string", "enum": ["content", "ideas", "visuals", "multimedia", "design", "strategy", "code", "repository"]},
    "connected_urls": {"type": "array", "maxItems": 12, "items": {"type": "object", "additionalProperties": false, "required": ["label", "url"], "properties": {"label": {"type": "string", "minLength": 1, "maxLength": 80}, "url": {"type": "string", "format": "uri", "maxLength": 2000}}},
    "other_label": {"type": "string", "minLength": 1},
    "usage_notes": {"type": "string", "minLength": 1}
  },
  "allOf": [
    {
      "if": {
        "anyOf": [
          {"properties": {"content_type": {"const": "Other"}}, "required": ["content_type"]},
          {"properties": {"library_status": {"const": "other"}}, "required": ["library_status"]},
          {"properties": {"preview_type": {"const": "other"}}, "required": ["preview_type"]},
          {"properties": {"portfolio_status": {"const": "other"}}, "required": ["portfolio_status"]}
        ]
      },
      "then": {"required": ["other_label"]}
    }
  ]
}
